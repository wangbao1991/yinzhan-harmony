{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:app_icon",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:start_window_icon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "backgroundModes": [
          "audioPlayback"
        ],
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "action.system.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "type": "general.java-script",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/javascript",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/javascript",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/x-javascript",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "text/plain",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "general.plain-text",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "type": "application/octet-stream",
                "linkFeature": "FileOpen"
              },
              {
                "scheme": "file",
                "utd": "general.java-script",
                "linkFeature": "FileOpen"
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "PlayerCardAbility",
        "srcEntry": "./ets/form/PlayerCardAbility.ets",
        "label": "$string:PlayerCard_label",
        "description": "$string:PlayerCardAbility_desc",
        "type": "form",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      }
    ],
    "metadata": [
      {
        "name": "ohos.network.security.config",
        "resource": "$profile:network_config"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      }
    ]
  }
}
